# backend/.env의 예시. 실제 .env는 추적하지 않는다.
# 이 파일을 .env로 복사한 뒤 값을 채울 것.

# 포트 규칙: Gateway\nginx\conf\conf.d\00-default.conf
PORT=18201

### PostgreSQL
# 네이티브 실행이므로 127.0.0.1(컨테이너가 5432를 호스트에 공개)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gp-lab
DB_USER=postgres
DB_PASS=

# 스키마는 game_climb. 코드(src/routes/*.ts)와 sql/001_init.sql에 적혀 있다.

# 게이트웨이와 개발 서버가 같은 오리진으로 넘겨 주므로 CORS는 거의 쓰이지 않는다.
# 쉼표로 여러 오리진을 적는다. *이면 모두 받는다.
CORS_ORIGIN=http://localhost:28201,http://climb.game.localhost

# 0으로 쓴다. 1이면 기동할 때마다 sql/001_init.sql이 돈다.
# 스키마를 새로 세울 때만 잠깐 1로 올리고 다시 0으로 돌린다.
DB_INIT=0
